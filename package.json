    "capture": "node scripts/capture-pages.js",
    "offline": "node scripts/parse-offline.js",
    "inspect": "node scripts/inspect-dom.js",
    "inspect:deep": "node scripts/inspect-deep.js"
  },
  "keywords": [
    "shopee",
    "scraper",
    "adspower",
    "cdp",
    "playwright"
  ],
  "author": "",
